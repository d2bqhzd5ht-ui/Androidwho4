<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:title="@string/detail_title"
        app:titleTextColor="@color/text_green" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_title" />

                <TextView
                    android:id="@+id/tv_book_title"
                    style="@style/DetailValue" />
            </LinearLayout>

            <View style="@style/DetailDivider" />

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_author" />

                <TextView
                    android:id="@+id/tv_book_author"
                    style="@style/DetailValue" />
            </LinearLayout>

            <View style="@style/DetailDivider" />

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_publisher" />

                <TextView
                    android:id="@+id/tv_book_publisher"
                    style="@style/DetailValue" />
            </LinearLayout>

            <View style="@style/DetailDivider" />

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_price" />

                <TextView
                    android:id="@+id/tv_book_price"
                    style="@style/DetailValue" />
            </LinearLayout>

            <View style="@style/DetailDivider" />

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_isbn" />

                <TextView
                    android:id="@+id/tv_book_isbn"
                    style="@style/DetailValue" />
            </LinearLayout>

            <View style="@style/DetailDivider" />

            <LinearLayout style="@style/DetailRow">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/label_year" />

                <TextView
                    android:id="@+id/tv_book_year"
                    style="@style/DetailValue" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
