<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BookManager" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/text_green</item>
        <item name="colorPrimaryDark">@color/text_green</item>
        <item name="colorAccent">@color/text_green</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@color/text_green</item>
    </style>

    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_green</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_green</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DetailDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
