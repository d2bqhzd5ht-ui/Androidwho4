<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnStartActivity1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_activity1" />

    <Button
        android:id="@+id/btnStartActivity2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_activity2" />

    <Button
        android:id="@+id/btnStartActivity3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_activity3" />

    <Button
        android:id="@+id/btnStartActivity4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_activity4" />

</LinearLayout>